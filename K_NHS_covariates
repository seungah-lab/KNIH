# m1, m5, m7은 각각 1차, 5차, 7차 데이터프레임입니다.
# 지정된 값 외의 결측 코드(66666, 77777, 99999)는 NA로 처리합니다.
harmonize <- function(dat, sources) {
	for (new_name in names(sources)) {
		src <- sources[[new_name]]
		src <- src[src %in% names(dat)]
		if (length(src) == 0L) {
			dat[[new_name]] <- NA_real_
			next
		}
		x <- dat[[src[1L]]]
		x <- suppressWarnings(as.numeric(as.character(x)))
		x[x %in% c(66666, 77777, 99999)] <- NA_real_
		dat[[new_name]] <- x
	}
	dat
}

# 원 응답을 그대로 보존하는 항목
common_vars <- list(
	hosp_beds = c("KN1_M010010", "KN5_P02_Q007"),
	hosp_exp  = "KN5_P02_Q011",
	position  = c("KN1_M010012", "KN5_P02_Q009"),
	degree    = c("KN1_M010017", "KN5_P02_Q013"),
	standing  = c("KN1_M010221", "KN5_P10_Q005"),
	radiation = c("KN1_M010227", "KN5_P12_Q002_02"),
	aerosol   = c("KN1_M010237", "KN5_P13_Q001_02"),
	chemo     = c("KN1_M010252", "KN5_P14_Q001_04")
)

# 혼인/동거 상태: 2 또는 6은 1, 1/3/4/5는 0
cohabit_var <- function(dat, sources) {
	src <- sources[sources %in% names(dat)]
	if (!length(src)) {
		dat$cohabit <- NA_real_
	} else {
		x <- suppressWarnings(as.numeric(as.character(dat[[src[1L]]])))
		dat$cohabit <- ifelse(x %in% c(66666, 77777, 99999), NA_real_,
													ifelse(x %in% c(2, 6), 1,
																 ifelse(x %in% c(1, 3, 4, 5), 0, NA_real_)))
	}
	dat
}

# 고용형태는 차수별 응답 기준으로 이분화
full_time_var <- function(dat, source, wave) {
	if (!source %in% names(dat)) {
		dat$full_time <- NA_real_
	} else {
		x <- suppressWarnings(as.numeric(as.character(dat[[source]])))
		dat$full_time <- if (wave == 1) {
			ifelse(x %in% c(66666, 77777, 99999), NA_real_,
						 ifelse(x %in% c(1, 3), 1, ifelse(x %in% c(2, 4, 5), 0, NA_real_)))
		} else {
			ifelse(x %in% c(66666, 77777, 99999), NA_real_,
						 ifelse(x == 1, 1, ifelse(x %in% c(2, 3), 0, NA_real_)))
		}
	}
	dat
}

# 야간교대: KN3 응답은 2~8이면 1, 1이면 0; KN7 응답은 1이면 1, 2이면 0
night_shift_var <- function(dat, source, wave) {
	if (!source %in% names(dat)) {
		dat$night_shift <- NA_real_
	} else {
		x <- suppressWarnings(as.numeric(as.character(dat[[source]])))
		dat$night_shift <- if (wave == 7) {
			ifelse(x %in% c(66666, 77777, 99999), NA_real_,
						 ifelse(x == 1, 1, ifelse(x == 2, 0, NA_real_)))
		} else {
			ifelse(x %in% c(66666, 77777, 99999), NA_real_,
						 ifelse(x %in% 2:8, 1, ifelse(x == 1, 0, NA_real_)))
		}
	}
	dat
}

for (nm in c("m1", "m5", "m7")) {
	dat <- get(nm)
	dat <- harmonize(dat, common_vars)
	dat <- cohabit_var(dat, c("KN1_M010019", "KN5_P02_Q014"))

	if (nm == "m1") {
		dat <- full_time_var(dat, "KN1_M010214", 1)
		dat <- night_shift_var(dat, "KN3_P14_Q003", 1)
	} else if (nm == "m5") {
		dat <- full_time_var(dat, "KN5_P10_Q001", 5)
		dat <- night_shift_var(dat, "KN3_P14_Q003", 5)
	} else {
		dat <- night_shift_var(dat, "KN7_P04_Q001_02", 7)
	}
	assign(nm, dat)
}
