# Helper to generate zero-padded variable names
make_mdq_names <- function(prefix, numbers, suffix) {
  sprintf("%s%03d%s", prefix, numbers, suffix)
}

# Helper to safely sum columns even if they are characters/factors
safe_row_sum <- function(df, col_names, na.rm = FALSE) {
  # Subset and convert all selected columns to numeric
  mat <- sapply(df[, col_names, drop = FALSE], function(x) as.numeric(as.character(x)))
  # Treat values of 5 or greater as missing before summing
  mat[mat >= 5] <- NA_real_
  rowSums(mat, na.rm = na.rm)
}

